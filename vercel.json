{
    "version": 2,
    "framework": null,
    "outputDirectory": "frontend",
    "routes": [
        {
            "src": "/css/(.*)",
            "dest": "/css/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/js/$1"
        },
        {
            "src": "/material/(.*)",
            "dest": "/material/$1"
        },
        {
            "src": "/pages/(.*)",
            "dest": "/pages/$1"
        },
        {
            "src": "/manifest.json",
            "dest": "/manifest.json"
        },
        {
            "src": "/sw.js",
            "dest": "/sw.js"
        },
        {
            "src": "/",
            "dest": "/pages/login.html"
        },
        {
            "src": "/login",
            "dest": "/pages/login.html"
        },
        {
            "src": "/signup",
            "dest": "/pages/signup.html"
        },
        {
            "src": "/chat",
            "dest": "/pages/chat.html"
        },
        {
            "src": "/oauth-callback",
            "dest": "/pages/oauth-callback.html"
        },
        {
            "src": "/(.*)",
            "dest": "/pages/login.html"
        }
    ]
}